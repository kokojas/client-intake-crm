# Copy to .env.local. Demo mode needs none of these values.
# Leave paid AI disabled until your own shared meter is provisioned.
CRM_ENABLE_OPENAI=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
CRM_AI_BUDGET_USD=
CRM_AI_METER_URL=
CRM_AI_METER_PUBLISHABLE_KEY=
CRM_AI_METER_TOKEN=

# Required only for the Supabase owner workspace.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
CRM_OWNER_EMAIL=you@example.com
CRM_APP_URL=http://127.0.0.1:3101
